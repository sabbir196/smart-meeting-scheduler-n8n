    {
      "parameters": {
        "jsCode": "// Normalize incoming meeting request data\nconst body = $input.first().json.body || $input.first().json;\n\nconst title = body.title || 'Untitled Meeting';\nconst attendees = body.attendees || [];\nconst durationMinutes = parseInt(body.durationMinutes || 30, 10);\nconst requestedStart = body.requestedStart; // ISO string e.g. 2026-08-10T10:00:00+06:00\nconst requestedEnd = new Date(new Date(requestedStart).getTime() + durationMinutes * 60000).toISOString();\n\nreturn [{\n  json: {\n    title,\n    attendees,\n    durationMinutes,\n    requestedStart,\n    requestedEnd,\n    requesterEmail: body.requesterEmail || ''\n  }\n}];"
      },
      "id": "6256dfa8-5ec1-41bf-a0a7-35d958102b47",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        48
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "faraj00558899@gmail.com",
          "mode": "list",
          "cachedResultName": "faraj00558899@gmail.com"
        },
        "timeMin": "={{ $json.requestedStart.split('T')[0] }}T00:00:00",
        "timeMax": "={{ $json.requestedStart.split('T')[0] }}T23:59:59",
        "options": {
          "orderBy": "startTime"
        }
      },
      "id": "3ca09d4b-7fff-48f6-8037-c66b4cc14b9b",
      "name": "Get Existing Calendar Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        -672,
        48
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "0SJhGCpTOq0ArigC",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge normalized request with fetched events, then detect overlap\nconst request = $('Normalize Request').first().json;\nconst events = $input.all().map(item => item.json);\n\nconst reqStart = new Date(request.requestedStart).getTime();\nconst reqEnd = new Date(request.requestedEnd).getTime();\n\nconst conflicts = events.filter(ev => {\n  const evStart = new Date(ev.start?.dateTime || ev.start?.date).getTime();\n  const evEnd = new Date(ev.end?.dateTime || ev.end?.date).getTime();\n  return reqStart < evEnd && reqEnd > evStart;\n});\n\n// Build a simple list of busy slots for the day, to help suggest free time later\nconst busySlots = events.map(ev => ({\n  start: ev.start?.dateTime || ev.start?.date,\n  end: ev.end?.dateTime || ev.end?.date,\n  summary: ev.summary || ''\n}));\n\nreturn [{\n  json: {\n    ...request,\n    hasConflict: conflicts.length > 0,\n    conflictCount: conflicts.length,\n    conflictingEvents: conflicts.map(ev => ({\n      summary: ev.summary,\n      start: ev.start?.dateTime || ev.start?.date,\n      end: ev.end?.dateTime || ev.end?.date\n    })),\n    busySlots\n  }\n}];"
      },
      "id": "aa9dc712-f73e-43fb-86c7-b917bb2aca1e",
      "name": "Detect Conflict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
